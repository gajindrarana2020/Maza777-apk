rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection: Stores username, password, email, phone, wallet balance
    match /users/{userId} {
      allow read, write: if true;
    }

    // Withdrawals Collection: Stores payout requests with username, bank account, and status
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }
  }
}
